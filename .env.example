# Database
ATLASDB_URL=mongodb+srv://<user>:<password>@<cluster>/staymiles

# Auth (use a long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change-me

# Cloudinary (image uploads)
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini (review summary + safety score)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

PORT=8080
